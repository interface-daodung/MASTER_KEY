<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\MasterKeyVault\mkv.ico</ApplicationIcon>
    <Win32Icon>..\MasterKeyVault\mkv.ico</Win32Icon>
    <AssemblyName>mkv</AssemblyName>
    <Product>MasterKeyVault</Product>
    <Company>MasterKeyVault</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CredentialManagement" Version="1.0.2" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.12" />
  </ItemGroup>

</Project>
